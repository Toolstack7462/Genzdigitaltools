# ── WriteHuman gateway (deploy on writehuman1.genzdigitalstore.com) ───────────
# Copy to .env on the WriteHuman gateway app and fill the secrets. Same generic
# proxy-gateway/server.js as the other tools — only this .env differs.

PORT=3000
TOOL_KEY=writehuman
TOOL_NAME=WriteHuman

TARGET_ORIGIN=https://writehuman.ai
# WriteHuman's humanizer is the root page itself, so a client lease lands at "/".
DEFAULT_PATH=/
# Where an admin CAPTURE lease lands to log in fresh and save a session to the vault.
SIGNIN_PATH=/signup?mode=login

GATEWAY_PUBLIC_ORIGIN=https://writehuman1.genzdigitalstore.com
API_BASE=https://api.genzdigitalstore.com/api/crm/proxy/gateway

# MUST match the backend values exactly (same shared pair as the other proxy tools —
# copy from the API app's .env or any existing proxy gateway's env vars):
LEASE_SECRET=__SET_TO_BACKEND_PROXY_LEASE_SECRET__
GATEWAY_KEY=__SET_TO_BACKEND_PROXY_GATEWAY_KEY__

# If WriteHuman serves CSS/JS from a separate CDN/asset host that fails to load
# cross-origin, proxy it same-origin through the gateway, e.g.:
# ASSET_ORIGINS=https://cdn.writehuman.ai
# Keep IDENTITY_SHIELD unset unless proven auth-safe (it can log token SPAs out).

# ── Account/logout shield (per-tool) ──────────────────────────────────────────
# ACCOUNT_SHIELD is ON by default: logout is never proxied (it would kill the shared
# vault session), and account/billing/subscription/settings PAGE loads show a friendly
# "managed by Gen Z" notice while their billing APIs are stubbed. This is auth-safe and
# does NOT redact session JSON. Set ACCOUNT_SHIELD=0 only if a tool's working area lives
# under one of those path words (prefer NAV_BLOCK_EXCLUDE to carve out just that path).
#   NAV_BLOCK_EXCLUDE=/settings/editor        # don't block this working-area path
#   NAV_BLOCK_EXTRA=/manage-account,/wallet   # also block these tool-specific paths
# Direct-URL blocking for account pages BLOCK_NAV_RE misses (it is segment-bounded, so
# "/account" is blocked but "/myaccount" is NOT). Fragments are substring-matched and shown
# via the same friendly sendAccountNotice() page HIX uses — no duplicate blocking system.
# WriteHuman's /account, /profile, /settings, /billing, /subscription, /plans are already
# blocked by BLOCK_NAV_RE and /logout by LOGOUT_RE; this adds the /myaccount alias clients hit.
# NOTE: NAV_BLOCK_EXTRA also feeds the API stub, so do NOT add a fragment (e.g. "history")
# that appears in a tool API path or that request would be stubbed.
NAV_BLOCK_EXTRA=myaccount, my-account
# HIDE_SELECTORS: comma-separated EXACT CSS selectors for this tool's account/top-bar/
# avatar containers (shipped in the critical hide CSS before first paint + to overlay.js).
# NEVER include the editor / chat / upload / result area.
# WriteHuman's logged-in account cluster is <div class="flex items-center gap-2"> holding the
# <a href="/myaccount"> ("My Account") + the text-only "Sign Out" button. Generic rules hide the
# account LINK but not the text-only button, so it flashed for ~3s until the JS sweep caught it.
# Anchored on the unique /myaccount link (Tools uses aria-haspopup, nav uses other hrefs).
# Multi-form for robustness against exact nesting: the link itself, the adjacent/sibling Sign Out
# button, and the cluster div (by class and by direct child). Hides pre-paint, zero flash.
HIDE_SELECTORS=a[href*="/myaccount"], a[href*="/myaccount"] + button, a[href*="/myaccount"] ~ button, .flex.items-center.gap-2:has(a[href*="/myaccount"]), div:has(> a[href*="/myaccount"])

# ── Logged-out detection: MUST stay OFF for WriteHuman ────────────────────────
# WriteHuman authenticates with Supabase entirely CLIENT-SIDE, so the server-rendered page
# at '/' is the SAME shell whether signed in or not — it always carries the "Log in / Sign
# Up" CTAs and no logout control until JS hydrates. The content-based logged-out heuristic
# (sign-in AND sign-up CTA, NO logout/account control) therefore matches EVERY page load,
# so DETECT_LOGGED_OUT=1 would flag even a VALID session as expired and show the client a
# "session expired" page instead of the logged-in tool. The authoritative check is the
# backend's auth_status verify against WriteHuman's /api/me endpoint (tools.js), which only
# marks an account available when its cookies actually load a live session — so an invalid
# account is never selected and the client never reaches a cookieless/public page. Keep OFF
# (this matches the working HIX/BypassGPT gateways, which also don't set it).
DETECT_LOGGED_OUT=0

# ── Account-switch fix: per-lease browser-storage reset (WriteHuman & Ryne) ───
# WriteHuman (Supabase auth) is a client-side token SPA: it caches the signed-in account
# (and often a bearer token it replays in an Authorization header) in localStorage/
# sessionStorage on THIS gateway origin. That storage survives an account switch, so after
# you update this account's vault cookies the next launch would inject the NEW cookies yet
# the SPA could reopen the OLD/invalid account from storage. RESET_STORAGE_ON_NEW_LEASE=1
# clears storage exactly ONCE per lease (on the first page load of a fresh launch) so the
# latest saved cookies always define the account; within a session storage persists so the
# app works normally. Cookie-session tools (HIX/BypassGPT) don't need this. Leave ON here.
RESET_STORAGE_ON_NEW_LEASE=1

# ── Client-side Supabase session injection (REQUIRED for WriteHuman) ──────────
# WriteHuman authenticates ENTIRELY client-side with Supabase: the session lives in the
# `sb-<ref>-auth-token` cookie (often chunked `.0`/`.1`) that the in-browser Supabase SDK
# reads from document.cookie to render a logged-in app. The gateway attaches the vault
# cookies to the UPSTREAM request (enough for server-rendered tools like HIX/BypassGPT), but
# for this client-side-auth SPA the browser never sees that cookie — so the SDK finds no
# session and shows the PUBLIC "Log in / Sign Up" page even though valid cookies are saved
# in the vault. SUPABASE_BROWSER_SESSION=1 makes the gateway materialise ONLY the vault's
# Supabase auth cookies (names starting `sb-`) onto this gateway origin — clearing any prior
# account's `sb-*` cookies first — so the latest saved session always logs the client in.
# Cookie-session tools (HIX/BypassGPT) must NOT set this. Leave ON here.
SUPABASE_BROWSER_SESSION=1
# Account/profile/billing/logout HIDING + route blocking is already provided by the
# shared ACCOUNT_SHIELD (default ON) — no extra config needed. Only set HIDE_SELECTORS
# if this tool wraps its account/top-bar in an obfuscated class the generic rules miss:
#   HIDE_SELECTORS=header .user-menu, aside .account
